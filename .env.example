DATABASE_URL=postgresql+asyncpg://dtq:dtq@localhost:5432/dtq
DB_AUTO_CREATE=true
STORE_TYPE=postgres
QUEUE_TYPE=redis
REDIS_URL=redis://localhost:6379/0
QUEUE_KEY=dtq:tasks
LOG_LEVEL=info

REDIS_PORT=6379
POSTGRES_PORT=5432
POSTGRES_DB=dtq
POSTGRES_USER=dtq
POSTGRES_PASSWORD=dtq

REDIS_HEALTHCHECK_INTERVAL=5s
REDIS_HEALTHCHECK_TIMEOUT=3s
REDIS_HEALTHCHECK_RETRIES=5

POSTGRES_HEALTHCHECK_INTERVAL=5s
POSTGRES_HEALTHCHECK_TIMEOUT=3s
POSTGRES_HEALTHCHECK_RETRIES=5